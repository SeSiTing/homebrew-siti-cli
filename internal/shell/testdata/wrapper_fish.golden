# siti shell wrapper for fish - generated by siti-cli
#
# Exit-code-10 protocol:
#   - The Go binary writes shell statements to $SITI_EVAL_FILE (a temp file)
#     and exits with code 10.
#   - Non-exit-10 commands pass through directly (child processes inherit TTY).
set -gx SITI_WRAPPER 1
function siti
  set -l eval_file (mktemp)
  set -x SITI_EVAL_FILE $eval_file
  command siti $argv
  set -l code $status
  if test $code -eq 10
    test -s $eval_file; and eval (cat $eval_file)
    rm -f $eval_file
    return 0
  end
  rm -f $eval_file
  return $code
end
function grok
  if set -q SITI_GROK_MODEL_ID
    for arg in $argv
      if test "$arg" = "-m"; or test "$arg" = "--model"; or string match -q -- "--model=*" "$arg"
        command grok $argv
        return $status
      end
    end
    command grok --model $SITI_GROK_MODEL_ID $argv
    return $status
  end
  command grok $argv
end